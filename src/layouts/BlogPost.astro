---
import BaseLayout from './BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';

const { title, description, date, kicker, subtitle, readingTime, tags, headings = [], image } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={title} description={description} image={image}>
  <ReadingProgress />
  
  <div class="max-w-[1100px] mx-auto px-6 py-20 md:py-32 flex flex-col xl:flex-row gap-12 relative">
    <!-- Left Column: Table of Contents (Desktop only) -->
    <TableOfContents headings={headings} />

    <!-- Right Column: Essay Body -->
    <div class="flex-grow max-w-prose mx-auto xl:mx-0">
      <ScrollReveal>
        <div class="header mb-28">
          {kicker && <p class="type-kicker text-ink-dim mb-10">{kicker}</p>}
          <h1 class="type-display text-ink-strong mb-6">{title}</h1>
          {subtitle && <p class="font-garamond italic text-[1.15rem] leading-relaxed text-ink-dim max-w-[520px] mb-8">{subtitle}</p>}
          <div class="w-10 h-[1px] bg-accent-pale my-12"></div>
          <div class="flex items-center gap-4 text-xs type-label text-ink-dim">
            <span>{formattedDate}</span>
            <span>·</span>
            <span>{readingTime || '10 min read'}</span>
          </div>
        </div>
      </ScrollReveal>

      <div class="body-text">
        <article class="prose">
          <slot />
        </article>
      </div>

      {tags && tags.length > 0 && (
        <ScrollReveal>
          <div class="mt-28 pt-8 border-t border-ink-faint">
            <p class="type-label text-accent mb-4">Tags</p>
            <div class="flex flex-wrap gap-3">
              {tags.map((tag: string) => (
                <a href={`/tags/${tag}`} class="type-label text-ink-dim hover:text-ink-strong border border-ink-faint px-3 py-1 text-[0.62rem] transition-colors duration-200">
                  {tag}
                </a>
              ))}
            </div>
          </div>
        </ScrollReveal>
      )}
    </div>
  </div>
</BaseLayout>
