  function initTokenHeatmap() {
    const promptSelect = document.getElementById('prompt-select') as HTMLSelectElement | null;
    const toggleHallucination = document.getElementById('toggle-hallucination');
    const toggleTruth = document.getElementById('toggle-truth');
    const tokensDisplay = document.getElementById('tokens-display');
    const inspectTokenVal = document.getElementById('inspect-token-val');
    const inspectLogprobVal = document.getElementById('inspect-logprob-val');
    const inspectProbVal = document.getElementById('inspect-prob-val');
    const inspectInsightVal = document.getElementById('inspect-insight-val');

    if (!promptSelect || !toggleHallucination || !toggleTruth || !tokensDisplay || 
        !inspectTokenVal || !inspectLogprobVal || !inspectProbVal || !inspectInsightVal) return;

    // Populate dropdown
    promptSelect.innerHTML = '';
    trials.forEach(t => {
      const opt = document.createElement('option');
      opt.value = t.idx.toString();
      opt.textContent = `Trial ${t.idx}: ${t.prompt.substring(0, 45)}...`;
      promptSelect.appendChild(opt);
    });

    let currentTrialIdx = 1;
    let viewMode: 'hallucination' | 'truth' = 'hallucination';

    function getInsight(token: string, lp: number, isFactual: boolean): string {
      const prob = Math.exp(lp) * 100;
      
      if (!isFactual) {
        if (lp >= -0.5) {
          return `CLICHÉ ATTRACTOR EXTREME. The model is virtually certain of this continuation (${prob.toFixed(1)}%). It is operating in a closed loop of statistical grammatical necessity.`;
        } else if (lp >= -1.5) {
          return `FLUENT RECONSTRUCTION. This token represents standard, highly plausible academic phrasing. It follows the statistical contours of the training data.`;
        } else if (lp >= -3.0) {
          return `TRANSITIONAL OPTION. A standard connective or alternative wording. High fluency is maintained.`;
        } else {
          return `MUTED ENTROPY. A localized choice with slightly higher entropy, though still selected in the greedy path.`;
        }
      } else {
        if (lp >= -0.5) {
          return `FACTUAL CERTAINTY. This specific token is a grammatical certainty within the negative construct.`;
        } else if (lp >= -1.5) {
          return `TRANSITIONAL TRUTH. Grammatical continuity in the truth sequence.`;
        } else if (lp >= -3.0) {
          return `INFORMATION GAP. The model is entering a region of lower transition probability as it forms the truth statement.`;
        } else {
          return `NEGATION GRADIENT PENALTY. The model heavily penalizes the negation (${prob.toFixed(3)}% probability). Choosing this factual refusal conflicts with the model's primary next-token prediction objective.`;
        }
      }
    }

    function render() {
      const trial = trials.find(t => t.idx === currentTrialIdx)!;
      const data = viewMode === 'hallucination' ? trial.hallucination : trial.truth;
      
      // Update toggle buttons
      if (viewMode === 'hallucination') {
        toggleHallucination!.classList.add('active-tab');
        toggleTruth!.classList.remove('active-tab');
      } else {
        toggleTruth!.classList.add('active-tab');
        toggleHallucination!.classList.remove('active-tab');
      }

      // Render tokens
      tokensDisplay!.innerHTML = '';
      
      // Show the prompt first (styled as passive context)
      const promptSpan = document.createElement('span');
      promptSpan.className = "text-ink-dim opacity-75 font-sans mr-2 border-b border-dashed border-white/5 pb-1 block mb-2 text-xs leading-relaxed select-none";
      promptSpan.textContent = `Prompt: "${trial.prompt}..."`;
      tokensDisplay!.appendChild(promptSpan);

      // Render the completion tokens
      const completionContainer = document.createElement('div');
      completionContainer.className = "flex flex-wrap gap-1 mt-2";
      
      data.tokens.forEach((t, i) => {
        const tokenSpan = document.createElement('span');
        
        // Compute colors based on log prob
        let bgStyle = "";
        let borderStyle = "";
        let textClass = "";
        
        if (t.lp >= -0.5) {
          bgStyle = "background-color: rgba(16, 185, 129, 0.25);"; // Emerald
          borderStyle = "border: 1px solid rgba(16, 185, 129, 0.35);";
          textClass = "text-emerald-400 font-semibold";
        } else if (t.lp >= -1.5) {
          bgStyle = "background-color: rgba(223, 158, 108, 0.2);"; // Amber
          borderStyle = "border: 1px solid rgba(223, 158, 108, 0.3);";
          textClass = "text-amber-400/90";
        } else if (t.lp >= -3.0) {
          bgStyle = "background-color: rgba(124, 143, 166, 0.1);"; // Muted blue-gray
          borderStyle = "border: 1px solid rgba(124, 143, 166, 0.15);";
          textClass = "text-[#7c8fa6]";
        } else {
          bgStyle = "background-color: rgba(244, 63, 94, 0.2);"; // Muted red/rose
          borderStyle = "border: 1px solid rgba(244, 63, 94, 0.3);";
          textClass = "text-rose-450 text-rose-400/90";
        }
        
        // Escape newlines for display
        let dispText = t.tok;
        if (dispText === "\n") dispText = "\\n";
        else if (dispText === "\n\n") dispText = "\\n\\n";
        
        tokenSpan.className = `px-1.5 py-0.5 rounded cursor-pointer transition-all duration-150 text-[0.82rem] hover:scale-105 active:scale-95 ${textClass}`;
        tokenSpan.setAttribute('style', `${bgStyle} ${borderStyle}`);
        tokenSpan.textContent = dispText;
        
        tokenSpan.addEventListener('mouseenter', () => inspect(t, viewMode === 'truth'));
        tokenSpan.addEventListener('click', () => inspect(t, viewMode === 'truth'));
        
        completionContainer.appendChild(tokenSpan);
      });
      
      tokensDisplay!.appendChild(completionContainer);
    }

    function inspect(t: TokenDetail, isFactual: boolean) {
      const prob = Math.exp(t.lp) * 100;
      let dispToken = t.tok;
      if (dispToken === "\n") dispToken = "[newline]";
      else if (dispToken === "\n\n") dispToken = "[paragraph break]";
      
      inspectTokenVal!.textContent = `"${dispToken}"`;
      inspectLogprobVal!.textContent = t.lp.toFixed(4);
      inspectProbVal!.textContent = `${prob.toFixed(prob < 0.1 ? 3 : 1)}%`;
      inspectInsightVal!.textContent = getInsight(t.tok, t.lp, isFactual);
    }

    // Event listeners
    promptSelect.addEventListener('change', () => {
      currentTrialIdx = parseInt(promptSelect.value);
      render();
    });

    toggleHallucination.addEventListener('click', () => {
      viewMode = 'hallucination';
      render();
    });

    toggleTruth.addEventListener('click', () => {
      viewMode = 'truth';
      render();
    });

    render();
  }

  // Initialize
  initTokenHeatmap();
  document.addEventListener('astro:page-load', () => {
    initTokenHeatmap();
  });
</script>
