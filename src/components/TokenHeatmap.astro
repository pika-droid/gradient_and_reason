<!-- TokenHeatmap.astro: Interactive Token Probability Heatmap Simulator -->
<div class="sandbox-container my-12 p-6 border border-ink-faint bg-surface rounded-lg select-none transition-colors duration-300" id="token-heatmap-wrapper">
  <div class="sandbox-meta flex justify-between items-center mb-4 border-b border-ink-faint pb-3 flex-wrap gap-2">
    <span class="sandbox-title font-garamond text-[0.75rem] tracking-[0.15em] uppercase text-accent font-medium">Confidence Heatmap Explorer</span>
    <span class="sandbox-instructions text-[0.7rem] text-ink-dim italic">Select a prompt and toggle completions to inspect token confidence</span>
  </div>

  <!-- Selection Controls -->
  <div class="flex flex-col md:flex-row gap-4 mb-6">
    <div class="flex-1">
      <label for="prompt-select" class="block text-[0.65rem] font-mono uppercase tracking-wider text-ink-dim mb-2">Select Trial Prompt</label>
      <select 
        id="prompt-select" 
        class="w-full bg-[#09090a] border border-ink-faint rounded px-3 py-2 text-xs font-mono text-ink-strong focus:outline-none focus:border-accent cursor-pointer"
      >
        <!-- Options will be populated by JS -->
      </select>
    </div>
    
    <div class="flex items-end gap-2 shrink-0">
      <div class="w-full flex bg-[#09090a] border border-ink-faint p-1 rounded gap-1">
        <button id="toggle-hallucination" class="px-3 py-1.5 rounded text-xs font-mono font-medium transition-all duration-200 active-tab">
          Hallucination
        </button>
        <button id="toggle-truth" class="px-3 py-1.5 rounded text-xs font-mono font-medium transition-all duration-200">
          Factual Negation
        </button>
      </div>
    </div>
  </div>

  <!-- Interactive Heatmap Display -->
  <div class="bg-[#050506] border border-white/5 rounded p-5 mb-5 min-h-[8rem] flex flex-col justify-between">
    <div>
      <span class="block text-[0.65rem] font-mono uppercase tracking-wider text-ink-dim mb-3 border-b border-dashed border-white/5 pb-1">
        Sequence Visualization (Hover or Tap Token to Inspect)
      </span>
      <div class="font-mono text-sm leading-relaxed tracking-normal select-text" id="tokens-display">
        <!-- Rendered tokens -->
      </div>
    </div>
    
    <div class="flex justify-end gap-4 mt-4 pt-3 border-t border-dashed border-white/5 text-[0.65rem] font-mono text-ink-dim">
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-sm bg-emerald-500/25 border border-emerald-500/40"></span>
        <span>High Prob (>-0.5)</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-sm bg-amber-500/20 border border-amber-500/30"></span>
        <span>Medium (-0.5 to -1.5)</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-sm bg-blue-450/15 border border-blue-450/25" style="background-color: rgba(124, 143, 166, 0.1); border-color: rgba(124, 143, 166, 0.2);"></span>
        <span>Muted (-1.5 to -3.0)</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-sm bg-rose-500/20 border border-rose-500/30"></span>
        <span>Low (<-3.0)</span>
      </div>
    </div>
  </div>

  <!-- Token Inspector Console -->
  <div class="bg-[#09090a] border border-white/5 rounded p-4 font-mono text-[0.72rem] text-code-txt">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 border-b border-white/5 pb-3 mb-3">
      <div>
        <span class="block text-ink-dim text-[0.65rem] uppercase">Inspected Token</span>
        <span id="inspect-token-val" class="text-sm font-bold text-accent-glowing">Click a token</span>
      </div>
      <div>
        <span class="block text-ink-dim text-[0.65rem] uppercase">Log-Probability</span>
        <span id="inspect-logprob-val" class="text-sm font-bold text-ink-strong">—</span>
      </div>
      <div>
        <span class="block text-ink-dim text-[0.65rem] uppercase">Linear Probability</span>
        <span id="inspect-prob-val" class="text-sm font-bold text-ink-strong">—</span>
      </div>
    </div>
    
    <div>
      <span class="block text-ink-dim text-[0.65rem] uppercase mb-1">Model State / Diagnostic Insight</span>
      <p id="inspect-insight-val" class="text-ink-strong leading-relaxed min-h-[2rem]">
        Hover or tap any highlighted token to reverse-engineer the model's confidence distribution.
      </p>
    </div>
  </div>
</div>

<style>
  #token-heatmap-wrapper .active-tab {
    background-color: rgba(223, 158, 108, 0.15);
    color: #df9e6c;
    border: 1px solid rgba(223, 158, 108, 0.25);
  }
  
  #token-heatmap-wrapper button:not(.active-tab) {
    color: #6b6358;
    border: 1px solid transparent;
  }
  
  #token-heatmap-wrapper button:not(.active-tab):hover {
    color: #c8bfaa;
    background-color: rgba(255, 255, 255, 0.02);
  }
</style>

